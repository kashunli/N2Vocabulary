#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)

if command -v pwsh >/dev/null 2>&1; then
    powershell_command=pwsh
elif command -v powershell.exe >/dev/null 2>&1; then
    powershell_command=powershell.exe
else
    echo "N2Vocabulary pre-commit: PowerShell (pwsh or powershell.exe) is required." >&2
    exit 1
fi

exec "$powershell_command" -NoProfile -ExecutionPolicy Bypass \
    -File "$repo_root/tools/verify.ps1" -Scope Changed

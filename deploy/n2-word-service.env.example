# Copy this file to /etc/n2-word-service.env and adjust the public origin.
# The workflow's default release root is /opt/n2-vocabulary.
N2_WORD_SERVICE_MODE=public
N2_WORD_SERVICE_HOST=127.0.0.1
N2_WORD_SERVICE_PORT=8767
N2_WORD_SERVICE_ORIGIN=https://vocabulary.example.com
N2_WORD_SERVICE_DB=/opt/n2-vocabulary/current/wordService/data/n2vocab.sqlite
N2_WORD_SERVICE_STATIC=/opt/n2-vocabulary/current/wordService/static
N2_WORD_SERVICE_CLIPS=/opt/n2-vocabulary/current/clips
N2_WORD_SERVICE_USERS_DB=/var/lib/n2-word-service/users.sqlite
N2_WORD_SERVICE_REVIEW_DB=/var/lib/n2-word-service/audio_reviews.sqlite
N2_WORD_SERVICE_REVIEW_EVIDENCE=/opt/n2-vocabulary/current/reviews/vocabulary_audio/n2_all_both_candidates.json
N2_WORD_SERVICE_REVIEW_SEED=/opt/n2-vocabulary/current/reviews/vocabulary_audio/n2_all_both.json
N2_WORD_SERVICE_TTS_DIR=generated_sentences/edge_tts

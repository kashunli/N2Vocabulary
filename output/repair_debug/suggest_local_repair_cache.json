{
  "whisper_cpp_large-v3-turbo:audio/Unit3 形容詞A/19 1-19.mp3:piece:22:52.438:55.267:-32dB:0.250": "いつも部下の成果を自分のものにしてしまう。",
  "whisper_cpp_large-v3-turbo:audio/Unit3 形容詞A/19 1-19.mp3:piece:23:56.995:57.961:-32dB:0.250": "肉らしい",
  "whisper_cpp_large-v3-turbo:audio/Unit3 形容詞A/19 1-19.mp3:piece:24:58.641:59.942:-32dB:0.250": "我が子は可愛いが",
  "whisper_cpp_large-v3-turbo:audio/Unit3 形容詞A/19 1-19.mp3:piece:25:60.455:61.891:-32dB:0.250": "反抗的な態度をとると",
  "whisper_cpp_large-v3-turbo:audio/Unit3 形容詞A/19 1-19.mp3:piece:26:62.361:63.487:-32dB:0.250": "憎らしい時もある。",
  "whisper_cpp_large-v3-turbo:audio/Unit3 形容詞A/19 1-19.mp3:piece:27:65.223:65.825:-32dB:0.250": "にくい",
  "whisper_cpp_large-v3-turbo:audio/Unit3 形容詞A/19 1-19.mp3:piece:28:66.542:68.513:-32dB:0.250": "父を殺した犯人が憎い。",
  "whisper_cpp_large-v3-turbo:audio/Unit3 形容詞A/19 1-19.mp3:piece:29:70.178:70.980:-32dB:0.250": "険しい",
  "whisper_cpp_large-v3-turbo:audio/Unit3 形容詞A/19 1-19.mp3:piece:30:71.722:73.571:-32dB:0.250": "険しい山道を登る。",
  "whisper_cpp_large-v3-turbo:audio/Unit3 形容詞A/20 1-20.mp3:piece:9:19.319:21.373:-32dB:0.250": "このナイフは切れ味が鈍い。",
  "whisper_cpp_large-v3-turbo:audio/Unit3 形容詞A/20 1-20.mp3:piece:10:23.189:24.020:-32dB:0.250": "鋭い",
  "whisper_cpp_large-v3-turbo:audio/Unit3 形容詞A/20 1-20.mp3:piece:11:24.743:26.550:-32dB:0.250": "クマは鋭い爪を持っている。",
  "whisper_cpp_large-v3-turbo:audio/Unit3 形容詞A/20 1-20.mp3:piece:12:28.344:28.920:-32dB:0.250": "アライ",
  "whisper_cpp_large-v3-turbo:audio/Unit3 形容詞A/20 1-20.mp3:piece:13:29.728:31.165:-32dB:0.250": "彼は気性が荒い、",
  "whisper_cpp_large-v3-turbo:audio/Unit3 形容詞A/20 1-20.mp3:piece:14:32.964:33.892:-32dB:0.250": "強引な",
  "whisper_cpp_large-v3-turbo:audio/Unit3 形容詞A/20 1-20.mp3:piece:15:34.587:37.680:-32dB:0.250": "与党は国会で強引に法案を通した。",
  "whisper_cpp_large-v3-turbo:audio/Unit3 形容詞A/20 1-20.mp3:piece:16:39.467:40.155:-32dB:0.250": "勝手な",
  "whisper_cpp_large-v3-turbo:audio/Unit3 形容詞A/20 1-20.mp3:piece:17:40.850:42.004:-32dB:0.250": "勝手な言動は、",
  "whisper_cpp_large-v3-turbo:audio/Unit3 形容詞A/20 1-20.mp3:piece:18:42.409:43.970:-32dB:0.250": "他の人の迷惑になる",
  "whisper_cpp_large-v3-turbo:audio/Unit3 形容詞A/20 1-20.mp3:piece:19:45.693:46.449:-32dB:0.250": "強気な",
  "whisper_cpp_large-v3-turbo:audio/Unit3 形容詞A/17 1-17.mp3:piece:24:58.694:59.595:-32dB:0.250": "かわいそうになった。",
  "whisper_cpp_large-v3-turbo:audio/Unit3 形容詞A/17 1-17.mp3:piece:25:61.342:62.253:-32dB:0.250": "気の毒な",
  "whisper_cpp_large-v3-turbo:audio/Unit3 形容詞A/17 1-17.mp3:piece:26:63.047:63.561:-32dB:0.250": "彼女を",
  "whisper_cpp_large-v3-turbo:audio/Unit3 形容詞A/17 1-17.mp3:piece:27:64.070:66.908:-32dB:0.250": "先日、お父さんを事故で亡くされたそうだよ。",
  "whisper_cpp_large-v3-turbo:audio/Unit3 形容詞A/17 1-17.mp3:piece:28:67.998:69.058:-32dB:0.250": "お気の毒に",
  "whisper_cpp_large-v3-turbo:audio/Unit3 形容詞A/17 1-17.mp3:piece:29:70.794:71.654:-32dB:0.250": "貧しい",
  "whisper_cpp_large-v3-turbo:audio/Unit3 形容詞A/17 1-17.mp3:piece:30:72.454:73.051:-32dB:0.250": "私は",
  "whisper_cpp_large-v3-turbo:audio/Unit3 形容詞A/17 1-17.mp3:piece:31:73.492:74.930:-32dB:0.250": "貧しい家に育った。",
  "whisper_cpp_large-v3-turbo:audio/Unit3 形容詞A/17 1-17.mp3:piece:32:76.728:77.364:-32dB:0.250": "惜しい"
}

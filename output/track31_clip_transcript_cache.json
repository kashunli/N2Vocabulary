  "whisper_cpp_large-v3-turbo:output\\clips\\unit04\\word414.mp3:18358:1776501611836596200": "引っ込む",
  "whisper_cpp_large-v3-turbo:output\\clips\\unit04\\sentence414.mp3:65235:1776501612039272100": "秘書は客を応接室に通すと奥へ引っ込んだ",
  "whisper_cpp_large-v3-turbo:output\\clips\\unit04\\word415.mp3:14018:1776501618072215700": "詰め込む",
  "whisper_cpp_large-v3-turbo:output\\clips\\unit04\\sentence415.mp3:31908:1776501618263019700": "カバンに荷物を詰め込む。",
  "whisper_cpp_large-v3-turbo:output\\clips\\unit04\\word416.mp3:11616:1776501624382140200": "飲み込む",
  "whisper_cpp_large-v3-turbo:output\\clips\\unit04\\sentence416.mp3:33681:1776501624570104700": "食べ物を噛まずに飲み込む。",
  "whisper_cpp_large-v3-turbo:output\\clips\\unit04\\word417.mp3:13364:1776501630362195400": "運び込む",
  "whisper_cpp_large-v3-turbo:output\\clips\\unit04\\sentence417.mp3:41657:1776501630548674500": "引っ越しの荷物を部屋に運び込む。",
  "whisper_cpp_large-v3-turbo:output\\clips\\unit04\\word418.mp3:11409:1776501636401338100": "打ち込む",
  "whisper_cpp_large-v3-turbo:output\\clips\\unit04\\sentence418.mp3:32583:1776501636692539700": "パソコンにデータを打ち込む。",
  "whisper_cpp_large-v3-turbo:output\\clips\\unit04\\word419.mp3:16624:1776501642428001500": "注ぎ込む",
  "whisper_cpp_large-v3-turbo:output\\clips\\unit04\\sentence419.mp3:33989:1776501642613361100": "子供に愛情を注ぎ込む。",
  "whisper_cpp_large-v3-turbo:output\\clips\\unit04\\word420.mp3:10989:1776501648197457400": "引き込む",
  "whisper_cpp_large-v3-turbo:output\\clips\\unit04\\sentence420.mp3:36495:1776501648360184900": "友人を悪の道に引き込む。",
  "whisper_cpp_large-v3-turbo:output\\clips\\unit04\\word421.mp3:12660:1776501654470920100": "書き込む",
  "whisper_cpp_large-v3-turbo:output\\clips\\unit04\\sentence421.mp3:33209:1776501654653718500": "ノートに感想を書き込む。",
  "whisper_cpp_large-v3-turbo:output\\clips\\unit04\\word422.mp3:12974:1776501660892304200": "巻き込む",
  "whisper_cpp_large-v3-turbo:output\\clips\\unit04\\sentence422.mp3:38479:1776501661076515700": "事故に巻き込まれて怪我をした",
  "whisper_cpp_large-v3-turbo:output\\clips\\unit04\\word423.mp3:11145:1776501666851062900": "追い込む",
  "whisper_cpp_large-v3-turbo:output\\clips\\unit04\\sentence423.mp3:37174:1776501667049848800": "羊の群れを囲いに追い込む。",
  "whisper_cpp_large-v3-turbo:output\\clips\\unit04\\word424.mp3:12660:1776501672720888200": "呼び込む",
  "whisper_cpp_large-v3-turbo:output\\clips\\unit04\\sentence424.mp3:65807:1776501672926614200": "ある国では赤は運を呼び込む色だと言われている。",
  "whisper_cpp_large-v3-turbo:output\\clips\\unit04\\word425.mp3:15737:1776501679305501800": "座り込む",
  "whisper_cpp_large-v3-turbo:output\\clips\\unit04\\sentence425.mp3:32583:1776501679533671000": "疲れて椅子に座り込む。",
  "whisper_cpp_large-v3-turbo:output\\clips\\unit04\\word426.mp3:10365:1776501685289154500": "寝込む",
  "whisper_cpp_large-v3-turbo:output\\clips\\unit04\\sentence426.mp3:33472:1776501685434123200": "病気で1週間寝込んだ",
  "whisper_cpp_large-v3-turbo:output\\clips\\unit04\\word427.mp3:14169:1776501691085068800": "話し込む",
  "whisper_cpp_large-v3-turbo:output\\clips\\unit04\\sentence427.mp3:46036:1776501691300492100": "友人と電話で3時間も話し込んだ。",
  "whisper_cpp_large-v3-turbo:output\\clips\\unit04\\word428.mp3:18087:1776501697156735000": "黙り込む",
  "whisper_cpp_large-v3-turbo:output\\clips\\unit04\\sentence428.mp3:39467:1776501697477353000": "母は不機嫌になると黙り込む。",
  "whisper_cpp_large-v3-turbo:output\\clips\\unit04\\word429.mp3:15974:1776501703206648100": "止まり込む",
  "whisper_cpp_large-v3-turbo:output\\clips\\unit04\\sentence429.mp3:40852:1776501703425134200": "病院に泊まり込んで看病する",
  "whisper_cpp_large-v3-turbo:output\\clips\\unit04\\word430.mp3:15113:1776501708884208400": "住み込む",
  "whisper_cpp_large-v3-turbo:output\\clips\\unit04\\sentence430.mp3:55379:1776501709075511100": "弟子になって師匠の家に住み込む。",
  "whisper_cpp_large-v3-turbo:output\\clips\\unit04\\word431.mp3:10675:1776501714951368600": "煮込む",
  "whisper_cpp_large-v3-turbo:output\\clips\\unit04\\sentence431.mp3:20692:1776501715141578200": "弱火で煮込む。",
  "whisper_cpp_large-v3-turbo:output\\clips\\unit04\\word432.mp3:11513:1776501720574582600": "売り込む",
  "whisper_cpp_large-v3-turbo:output\\clips\\unit04\\sentence432.mp3:28726:1776501720754585100": "新製品を売り込む",
  "whisper_cpp_large-v3-turbo:output\\clips\\unit04\\word433.mp3:12971:1776501726335273600": "頼み込む",
  "whisper_cpp_large-v3-turbo:output\\clips\\unit04\\sentence433.mp3:44888:1776501726537568200": "頭を下げて先輩に頼み込んだ。",
  "whisper_cpp_large-v3-turbo:output\\clips\\unit04\\word434.mp3:15059:1776501732151894900": "教え込む",

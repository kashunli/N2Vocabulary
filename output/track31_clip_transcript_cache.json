{
  "whisper_cpp_large-v3-turbo:output\\clips\\unit04\\word412.mp3:15216:1776501599672267200": "差し込む",
  "whisper_cpp_large-v3-turbo:output\\clips\\unit04\\sentence412.mp3:46977:1776501599962174800": "日の光が部屋いっぱいに差し込んでいる。",

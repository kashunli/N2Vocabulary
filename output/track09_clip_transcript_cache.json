  "whisper_cpp_large-v3-turbo:output\\clips\\unit02\\sentence127.mp3:51987:1776478234932069300": "先生が生徒にプリントを配った",
  "whisper_cpp_large-v3-turbo:output\\clips\\unit02\\word128.mp3:8693:1776478239861635700": "オール",
  "whisper_cpp_large-v3-turbo:output\\clips\\unit02\\sentence128.mp3:20271:1776478239939606100": "ボールを放る",
  "whisper_cpp_large-v3-turbo:output\\clips\\unit02\\word129.mp3:5878:1776478244589935100": "オル",
  "whisper_cpp_large-v3-turbo:output\\clips\\unit02\\sentence129.mp3:28724:1776478244669409200": "地面に穴を掘る",
  "whisper_cpp_large-v3-turbo:output\\clips\\unit02\\word130.mp3:7729:1776478249516668900": "マーク",
  "whisper_cpp_large-v3-turbo:output\\clips\\unit02\\sentence130.mp3:38839:1776478249611787800": "畑に野菜の種をまく。",

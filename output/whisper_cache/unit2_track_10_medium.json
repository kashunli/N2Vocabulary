[
  {
    "start": 0.6800000000000024,
    "end": 6.12,
    "text": "引っ張る。この紐を引っ張ると電気がつく。"
  },
  {
    "start": 6.4,
    "end": 10.44,
    "text": "つく。喧嘩して相手の胸を手でついた。"
  },
  {
    "start": 11.8,
    "end": 17.8,
    "text": "突き当たる。この道をまっすぐ行って、突き当たったら左に曲がってください。"
  },
  {
    "start": 19.56,
    "end": 23.94,
    "text": "立ち止まる。道で声をかけられて立ち止まった。"
  },
  {
    "start": 24.96,
    "end": 31.36,
    "text": "近寄る。物音がしたので窓に近寄って外を見た。"
  },
  {
    "start": 32.12,
    "end": 36.5,
    "text": "横切る。道を横切って向こう側に渡った。"
  },
  {
    "start": 38.22,
    "end": 42.52,
    "text": "転ぶ。雪道で滑って転んでしまった。"
  },
  {
    "start": 43.98,
    "end": 48.5,
    "text": "つまずく。道で石につまずいて転んでしまった。"
  },
  {
    "start": 50.019999999999996,
    "end": 53.86,
    "text": "引く。車に引かれて骨折した。"
  },
  {
    "start": 55.26,
    "end": 59.98,
    "text": "溺れる。川に落ちて溺れている子供を助けた。"
  },
  {
    "start": 61.28,
    "end": 64.58,
    "text": "痛む。歯が痛む。"
  },
  {
    "start": 65.3,
    "end": 69.8,
    "text": "かかる。インフルエンザにかかって学校を休んだ。"
  },
  {
    "start": 71.52,
    "end": 74.24,
    "text": "酔う。酒に酔う。"
  },
  {
    "start": 75.33999999999999,
    "end": 79.06,
    "text": "吐く。息を吸って吐く。"
  },
  {
    "start": 79.92,
    "end": 85.24,
    "text": "見る。体の調子が悪いので医者に見てもらおう。"
  },
  {
    "start": 86.28,
    "end": 91.0,
    "text": "見舞う。入院中の友達をみんなで見舞った。"
  },
  {
    "start": 92.38,
    "end": 95.18,
    "text": "勤める。会社に勤める。"
  }
]

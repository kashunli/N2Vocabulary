  },
  {
    "start": 13.22,
    "end": 17.48,
    "text": "いいネクタイですねとおせじを言った"
  },
  {
    "start": 17.48,
    "end": 19.38,
    "text": "言い訳"
  },
  {
    "start": 19.38,
    "end": 26.2,
    "text": "田中さんはいつも言い訳ばかり言って自分の失敗を認めようとしない"
  },
  {
    "start": 26.9,
    "end": 27.7,
    "text": "話題"
  },
  {
    "start": 27.7,
    "end": 33.8,
    "text": "野中さんはとても話題が豊富な人で話していて楽しい"
  },
  {
    "start": 33.8,
    "end": 35.36,
    "text": "秘密"
  },
  {
    "start": 35.36,
    "end": 40.8,
    "text": "あなたを信用して私の秘密を打ち明けます"
  },
  {
    "start": 41.900000000000006,
    "end": 42.78,
    "text": "尊敬"
  },
  {
    "start": 42.78,
    "end": 48.54,
    "text": "マザーテレサは世界中の人々に尊敬されている"
  },
  {
    "start": 48.54,
    "end": 50.08,
    "text": "謙遜"
  },
  {
    "start": 50.08,
    "end": 56.54,
    "text": "褒められたとき謙遜してそんなことはありませんという人も多い"
  },
  {
    "start": 57.56,
    "end": 58.44,
    "text": "期待"
  },
  {
    "start": 58.44,
    "end": 64.94,
    "text": "山本選手の活躍を期待していたが期待外れの結果に終わった"
  },
  {
    "start": 64.94,
    "end": 66.38,
    "text": "苦労"
  },
  {
    "start": 66.38,
    "end": 72.62,
    "text": "父の死後母は苦労して私たちを育ててくれた"
  },
  {
    "start": 73.26,
    "end": 73.7,
    "text": "意思"
  },
  {
    "start": 74.16,
    "end": 79.84,
    "text": "彼女は意思が固いからきっと目的を達成するだろう"
  },
  {
    "start": 79.84,
    "end": 81.54,
    "text": "感情"
  },
  {
    "start": 81.54,
    "end": 84.26,
    "text": "田中さんはすぐに感情が顔に出る"

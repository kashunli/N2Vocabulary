[
  {
    "start": 0.6199999999999992,
    "end": 5.22,
    "text": "ほどける くつのひもがほどけた"
  },
  {
    "start": 5.22,
    "end": 11.3,
    "text": "ほどく にもつのひもをほどいて中のものを出す"
  },
  {
    "start": 11.3,
    "end": 16.78,
    "text": "かれる 害虫のせいで木が枯れてしまった"
  },
  {
    "start": 17.339999999999996,
    "end": 23.32,
    "text": "からす 病気が発生し多くの木を枯らしてしまった"
  },
  {
    "start": 23.32,
    "end": 29.92,
    "text": "痛む 生魚は痛みやすいから早く食べた方がいい"
  },
  {
    "start": 29.92,
    "end": 35.74,
    "text": "しめる 朝干した洗濯物がまだしめっている"
  },
  {
    "start": 35.74,
    "end": 39.9,
    "text": "凍る 水が凍る"
  },
  {
    "start": 39.9,
    "end": 45.52,
    "text": "震える 寒さに手足がブルブル震えた"
  },
  {
    "start": 45.52,
    "end": 50.58,
    "text": "輝く 空に太陽が輝いている"
  },
  {
    "start": 50.58,
    "end": 55.66,
    "text": "あふれる 大雨で川の水があふれた"
  },
  {
    "start": 56.31999999999999,
    "end": 61.04,
    "text": "あまる 作りすぎて料理が余ってしまった"
  },
  {
    "start": 61.879999999999995,
    "end": 67.22,
    "text": "目立つ 彼女は背が高いので目立つ"
  },
  {
    "start": 67.22,
    "end": 73.0,
    "text": "見下ろす このビルの屋上から街が見下ろせる"
  },
  {
    "start": 73.0,
    "end": 78.52,
    "text": "戦う 国と国とが領土をめぐって戦う"
  },
  {
    "start": 79.38,
    "end": 82.96,
    "text": "破れる 試合に破れる"
  },
  {
    "start": 83.56,
    "end": 87.36,
    "text": "逃げる 犯人は海外に逃げたらしい"
  }
]

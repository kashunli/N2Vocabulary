[
  {
    "start": 0.0,
    "end": 6.88,
    "text": "好む 一般にお年寄りはあっさりした味を好む"
  },
  {
    "start": 6.88,
    "end": 12.0,
    "text": "嫌う 彼女は彼を嫌っているようだ"
  },
  {
    "start": 13.039999999999997,
    "end": 17.0,
    "text": "願う 世界平和を願う"
  },
  {
    "start": 17.919999999999998,
    "end": 23.28,
    "text": "甘える 子供が母親に甘える"
  },
  {
    "start": 23.28,
    "end": 29.88,
    "text": "かわいがる 息子は妹をとてもかわいがっている"
  },
  {
    "start": 29.88,
    "end": 36.78,
    "text": "気づく 犯人は刑事に気づいて逃げてしまった"
  },
  {
    "start": 36.78,
    "end": 44.88,
    "text": "疑う 警察は私を犯人ではないかと疑っているらしい"
  },
  {
    "start": 44.88,
    "end": 51.22,
    "text": "苦しむ 学校でいじめられて苦しんでいる子供が大勢いる"
  },
  {
    "start": 52.52,
    "end": 60.6,
    "text": "悲しむ 娘はペットの死を悲しんで一日中泣いていた"
  },
  {
    "start": 60.6,
    "end": 66.54,
    "text": "がっかりする 試験に落ちてがっかりした"
  },
  {
    "start": 66.54,
    "end": 72.62,
    "text": "励ます 受験に失敗した友人を励ました"
  },
  {
    "start": 73.32,
    "end": 78.72,
    "text": "うなずく 祖父は何も言わずにうなずいた"
  },
  {
    "start": 79.68,
    "end": 87.22,
    "text": "張り切る 入社第1日目娘は張り切って出勤した"
  },
  {
    "start": 87.22,
    "end": 94.84,
    "text": "いばる 自分ができるからと言ってすぐにいばる人は嫌われる"
  },
  {
    "start": 95.3,
    "end": 100.94,
    "text": "怒鳴る そんなに大声で怒鳴らなくても聞こえますよ"
  },
  {
    "start": 101.82,
    "end": 109.96,
    "text": "暴れる 弟は気が短く子供の頃はすぐに暴れてよくものを壊したものだ"
  }

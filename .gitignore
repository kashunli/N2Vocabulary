# Source audio MP3 tracks
audio/

# OCR page images (PNG renders from PDF)
ocr*/
**/pages_*/
**/*.png

# Built Anki decks (large, can be regenerated)
*.apkg

# Cut audio clips from tracks
output/clips/

# Generated HTML (regenerated by make_html.py)
output/html/

# Virtual environment
.venv/

# Temporary / generated files
__pycache__/
*.pyc

# Whisper.cpp binary, DLLs, and model files (large, built/downloaded locally)
tools/whispercpp-windows/*.exe
tools/whispercpp-windows/*.dll
tools/whispercpp-windows/*.bin

# Whisper.cpp source build (at D:\wcpp\, not in repo)
tools/whispercpp-windows/whisper.cpp-src/
